# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` ni `.env.local` al repo.
# `neon checkout <rama>` / `neon env pull` escriben DATABASE_URL, DATABASE_URL_UNPOOLED y
# NEON_BRANCH en `.env`. Si existe `.env.local`, Next.js le da prioridad sobre `.env`.

# ── Base de datos (Neon) ─────────────────────────────────────────
# Neon Console → proyecto → Connect. Pooled para la app; directa (unpooled) para migraciones.
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=verify-full
# Opcional: usuario con permisos DDL para migraciones (producción). En local se usa DATABASE_URL_UNPOOLED.
# DATABASE_URL_MIGRATOR=
# Rama `test` de Neon, solo para tests de integración (opcional).
DATABASE_URL_TEST=

# ── Seed (`npm run db:seed` y `npm run db:reset-demo`) ───────────
# Solo los leen los scripts del seed (lib/db/seed/env.ts); la app desplegada no los necesita.
# Correo del super_admin que crea el seed (p. ej. el del dueño del proyecto). Nunca puede estar en
# SEED_ORGANIZER_EMAILS: el seed aborta sin escribir nada.
SUPER_ADMIN_EMAIL=
# Organizadores reales de prueba, separados por comas (al menos uno): el seed los crea `approved` y les reparte
# los eventos demo.
SEED_ORGANIZER_EMAILS=linderhassinger02@gmail.com,linderhassingerwotdev@gmail.com
# ALLOW_DEMO_RESET no va aquí: se pasa en la misma línea de `npm run db:reset-demo` (ver README).

# ── Clerk ────────────────────────────────────────────────────────
# Clerk Dashboard → API Keys (instancia de desarrollo en local).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
# Clerk Dashboard → Webhooks → endpoint → Signing Secret.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro

# ── Stripe ───────────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys (modo test en local).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# Local: lo imprime `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_

# ── Google Maps ──────────────────────────────────────────────────
# Fijar o cambiar una variable exige reiniciar `npm run dev` o volver a ejecutar `npm run build`.

# Clave de la Maps Embed API de Google (mapa de la sección "Lugar" en el detalle del evento).
# Opcional: sin ella se muestra el marcador decorativo y "Cómo llegar" funciona igual.
# Es pública (termina en el HTML): restríngela en Google Cloud Console
#   - por referrers HTTP: el dominio de producción y http://localhost:3000/*
#   - por API: solo "Maps Embed API".
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
