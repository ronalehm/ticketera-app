# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` ni `.env.local` al repo.
# `neon checkout <rama>` / `neon env pull` escriben DATABASE_URL, DATABASE_URL_UNPOOLED y
# NEON_BRANCH en `.env`. Si existe `.env.local`, Next.js le da prioridad sobre `.env`.

# ── App ──────────────────────────────────────────────────────────
# URL pública de la app, obligatoria y solo de servidor (http/https; la barra final se quita). Base de las URLs
# absolutas que salen del servidor, p. ej. el enlace de las invitaciones de Clerk (`<APP_URL>/registro`).
#   - local: http://localhost:3000
#   - preview (Vercel): la URL de la rama, p. ej. https://ticketera-app-x6xq-git-<rama>-<equipo>.vercel.app
#   - producción: https://ticketera-app-x6xq.vercel.app
APP_URL=http://localhost:3000

# ── Base de datos (Neon) ─────────────────────────────────────────
# Neon Console → proyecto → Connect. Pooled para la app; directa (unpooled) para migraciones.
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=verify-full
# Opcional: usuario con permisos DDL para migraciones (producción). En local se usa DATABASE_URL_UNPOOLED.
# DATABASE_URL_MIGRATOR=
# Rama `test` de Neon, solo para tests de integración (opcional).
DATABASE_URL_TEST=

# ── Seed (`npm run db:seed` y `npm run db:reset-demo`) ───────────
# Solo los leen los scripts del seed (lib/db/seed/env.ts); la app desplegada no los necesita.
# Correo del super_admin que crea el seed (p. ej. el del dueño del proyecto). Nunca puede estar en
# SEED_ORGANIZER_EMAILS: el seed aborta sin escribir nada.
SUPER_ADMIN_EMAIL=
# Organizadores reales de prueba, separados por comas (al menos uno): el seed los crea `approved` y les reparte
# los eventos demo.
SEED_ORGANIZER_EMAILS=linderhassinger02@gmail.com,linderhassingerwotdev@gmail.com
# ALLOW_DEMO_RESET no va aquí: se pasa en la misma línea de `npm run db:reset-demo` (ver README).

# ── Clerk ────────────────────────────────────────────────────────
# Clerk Dashboard → API Keys (instancia de desarrollo en local).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
# Clerk Dashboard → Webhooks → endpoint → Signing Secret.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro

# ── Stripe ───────────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys (modo test en local).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# Local: lo imprime `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_

# ── Vercel Blob (portadas de eventos) ────────────────────────────
# Store `ticketera-media` (Public) conectado por OIDC: sin token de lectura/escritura (nunca BLOB_READ_WRITE_TOKEN
# ni NEXT_PUBLIC_BLOB_*). En Vercel las crea la conexión del store y VERCEL_OIDC_TOKEN lo inyecta el runtime.
# Local: `vercel env pull .env.local` (proyecto ticketera-app-x6xq, con Development en la conexión del store) trae
# las tres. Opcionales: sin BLOB_STORE_ID o BLOB_WEBHOOK_PUBLIC_KEY la subida responde 503 y queda «Usar URL».
# BLOB_WEBHOOK_PUBLIC_KEY la exige `handleUploadPresigned` (@vercel/blob 2.8.0: «Missing webhook public key») aunque no
# se use el callback de subida completada.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# ── Correo transaccional (Resend) ─────────────────────────────────
# Notificaciones a compradores cuando cambia o se cancela un evento. Solo servidor: nunca con prefijo NEXT_PUBLIC_
# y nunca la clave en logs, issues ni documentación. Todas opcionales: sin RESEND_API_KEY o sin EMAIL_FROM las
# notificaciones se encolan y el envío se omite (quedan `pending`).
# Resend → API Keys (empieza por `re_`; en local, la de prueba/Preview, nunca la de Production).
RESEND_API_KEY=
# Remitente con el formato `Nombre <correo@dominio>` (dominio verificado en Resend).
EMAIL_FROM=
# `live` o `allowlist` (por defecto). `live` solo tiene efecto en Production de Vercel (VERCEL_ENV=production); en
# Preview y local se fuerza `allowlist` aunque diga `live`.
EMAIL_DELIVERY_MODE=
# Correos de prueba separados por comas (se comparan en minúsculas). En modo `allowlist` solo se envía a ellos; es
# obligatoria si hay RESEND_API_KEY y el modo efectivo es `allowlist`.
EMAIL_ALLOWED_RECIPIENTS=
# Secreto del cron de notificaciones (≥ 16 caracteres); Vercel lo envía como `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ── Google Maps ──────────────────────────────────────────────────
# Fijar o cambiar una variable exige reiniciar `npm run dev` o volver a ejecutar `npm run build`.

# Clave de la Maps Embed API de Google (mapa de la sección "Lugar" en el detalle del evento).
# Opcional: sin ella se muestra el marcador decorativo y "Cómo llegar" funciona igual.
# Es pública (termina en el HTML): restríngela en Google Cloud Console
#   - por referrers HTTP: el dominio de producción y http://localhost:3000/*
#   - por API: solo "Maps Embed API".
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
